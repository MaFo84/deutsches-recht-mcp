# Geheimer Pfadbestandteil: Endpunkt = https://<host>/<MCP_PATH_SECRET>/mcp
MCP_PATH_SECRET=bitte-langen-zufallswert-setzen
# Optional: zusätzlich Bearer-Token (nur für Clients, die Header setzen können; NICHT für Claude Custom Connector)
MCP_BEARER_TOKEN=
# Optional: erlaubte Host-Header (DNS-Rebinding-Schutz), z.B. recht.fostec.com
ALLOWED_HOSTS=
# Optional: API-Token von Open Legal Data (falls die API künftig einen verlangt)
OLDP_API_TOKEN=
PORT=8000
